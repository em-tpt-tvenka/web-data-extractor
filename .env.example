# Copy to .env and fill in. Never commit real credentials or endpoints.

# Dedicated project Redis (docker-compose.yml), host port 6380.
celery_broker_url=redis://localhost:6380/0
celery_result_backend=redis://localhost:6380/1

# "celery" (needs Redis + a worker) or "inline" (in-process, no broker).
job_executor=celery

mongo_uri=mongodb://localhost:27017
mongo_db=web_data_extractor

# ---------------------------------------------------------------------------
# US network routing (Walmart + Best Buy only; every other platform is DIRECT).
# ---------------------------------------------------------------------------
us_routing_enabled=true

# Primary route: a real US proxy endpoint (HTTP/HTTPS/SOCKS5).
us_proxy_enabled=true
us_proxy_url=

# Fallback route: a dedicated US VPN-provided proxy/SOCKS endpoint. A true
# OS split-tunnel VPN is external infrastructure and is not configured here.
us_vpn_enabled=true
us_vpn_mode=proxy_endpoint
us_vpn_url=

# Which platforms must use US routing (comma-separated).
us_proxy_platforms=walmart,bestbuy

# Validation + retry behaviour.
us_expected_country=US
us_route_timeout=30
us_route_max_retries=2
us_ip_validation_enabled=true
us_ip_check_url=https://ipinfo.io/json

# Optional global proxy applied to every platform (normally left blank).
proxy_url=
rotate_user_agents=true
